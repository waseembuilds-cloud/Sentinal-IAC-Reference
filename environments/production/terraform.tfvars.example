aws_region           = "us-east-1"
project_name         = "sentinel"
environment          = "production"
evidence_bucket_name = "sentinel-production-evidence-replace-with-unique-suffix"

networking = {
  vpc_cidr             = "10.30.0.0/16"
  public_subnet_cidrs  = ["10.30.0.0/24", "10.30.1.0/24"]
  private_subnet_cidrs = ["10.30.10.0/24", "10.30.11.0/24"]
  nat_gateway_count    = 2
}

security = {
  kms_deletion_window_days = 30
  waf_rate_limit           = 5000
  waf_log_retention_days   = 90
}

identity = {
  deletion_protection              = true
  mfa_configuration                = "ON"
  password_minimum_length          = 14
  temporary_password_validity_days = 3
  access_token_validity_minutes    = 30
  id_token_validity_minutes        = 30
  refresh_token_validity_days      = 7
}

compute = {
  alb_listener_port                = 80
  alb_https_port                   = 443
  acm_certificate_arn              = "arn:aws:acm:us-east-1:000000000000:certificate/00000000-0000-0000-0000-000000000000"
  application_domain_name          = "app.example.com"
  alb_ssl_policy                   = "ELBSecurityPolicy-TLS13-1-2-2021-06"
  alb_ingress_cidrs                = ["0.0.0.0/0"]
  container_name                   = "sentinel-app"
  container_image                  = "public.ecr.aws/docker/library/nginx:stable"
  container_port                   = 80
  health_check_path                = "/"
  health_check_matcher             = "200-399"
  health_check_interval            = 30
  health_check_healthy_threshold   = 3
  health_check_unhealthy_threshold = 3
  health_check_timeout             = 5
  health_check_grace_period_seconds = 90
  database_identifier              = "sentinel-production-db"
  database_name                    = "sentinel"
  database_username                = "sentinel_admin"
  database_port                    = 5432
  database_engine_version          = "16.3"
  database_instance_class          = "db.r6g.large"
  database_allocated_storage       = 100
  database_max_allocated_storage   = 1000
  database_multi_az                = true
  database_backup_retention_days   = 35
  database_deletion_protection     = true
  database_skip_final_snapshot     = false
  database_apply_immediately       = false
  task_cpu                         = 1024
  task_memory                      = 2048
  desired_count                    = 2
  minimum_task_count               = 2
  maximum_task_count               = 8
  target_cpu_utilization           = 60
  target_memory_utilization        = 70
  scale_in_cooldown_seconds        = 300
  scale_out_cooldown_seconds       = 60
  alarm_sns_topic_arn              = ""
  alb_5xx_alarm_threshold          = 25
  database_cpu_alarm_threshold     = 80
  database_free_storage_alarm_threshold_bytes = 10737418240
  application_environment          = { APP_ENV = "production" }
  log_retention_days               = 90
  force_destroy_evidence_bucket    = false
}
