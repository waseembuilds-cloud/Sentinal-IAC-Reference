aws_region          = "us-east-1"
project_name        = "sentinel"
environment         = "staging"
evidence_bucket_name = "sentinel-staging-evidence-replace-with-unique-suffix"

networking = {
  vpc_cidr             = "10.20.0.0/16"
  public_subnet_cidrs  = ["10.20.0.0/24", "10.20.1.0/24"]
  private_subnet_cidrs = ["10.20.10.0/24", "10.20.11.0/24"]
  nat_gateway_count    = 1
}

security = {
  kms_deletion_window_days = 14
  waf_rate_limit           = 2000
  waf_log_retention_days   = 30
}

identity = {
  deletion_protection              = false
  mfa_configuration                = "OPTIONAL"
  password_minimum_length          = 12
  temporary_password_validity_days = 7
  access_token_validity_minutes    = 60
  id_token_validity_minutes        = 60
  refresh_token_validity_days      = 30
}

compute = {
  alb_listener_port                = 80
  alb_https_port                   = 443
  acm_certificate_arn              = "arn:aws:acm:us-east-1:000000000000:certificate/00000000-0000-0000-0000-000000000000"
  application_domain_name          = "staging.example.com"
  alb_ssl_policy                   = "ELBSecurityPolicy-TLS13-1-2-2021-06"
  alb_ingress_cidrs                = ["0.0.0.0/0"]
  container_name                   = "sentinel-app"
  container_image                  = "public.ecr.aws/docker/library/nginx:stable"
  container_port                   = 80
  health_check_path                = "/"
  health_check_matcher             = "200-399"
  health_check_interval            = 30
  health_check_healthy_threshold   = 2
  health_check_unhealthy_threshold = 3
  health_check_timeout             = 5
  health_check_grace_period_seconds = 60
  database_identifier              = "sentinel-staging-db"
  database_name                    = "sentinel"
  database_username                = "sentinel_admin"
  database_port                    = 5432
  database_engine_version          = "16.3"
  database_instance_class          = "db.t4g.micro"
  database_allocated_storage       = 20
  database_max_allocated_storage   = 100
  database_multi_az                = false
  database_backup_retention_days   = 7
  database_deletion_protection     = false
  database_skip_final_snapshot     = true
  database_apply_immediately       = true
  task_cpu                         = 256
  task_memory                      = 512
  desired_count                    = 1
  minimum_task_count               = 1
  maximum_task_count               = 2
  target_cpu_utilization           = 60
  target_memory_utilization        = 70
  scale_in_cooldown_seconds        = 300
  scale_out_cooldown_seconds       = 60
  alarm_sns_topic_arn              = ""
  alb_5xx_alarm_threshold          = 10
  database_cpu_alarm_threshold     = 80
  database_free_storage_alarm_threshold_bytes = 5368709120
  application_environment          = { APP_ENV = "staging" }
  log_retention_days               = 14
  force_destroy_evidence_bucket    = false
}
